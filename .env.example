# Copy to .env (or set in the Vercel project settings). NEVER commit real values.

# REQUIRED before going live: platform-issued secret from the dashboard
# "Rotate Secret" (revealed once). Without it the code uses a clearly marked
# local placeholder and the platform preflight WILL fail.
AGENT_GAMES_HMAC_SECRET=

# Outbound signature encoding: "hex" (default) or "sha256=".
# Inbound verification accepts both forms either way.
AGENT_GAMES_HMAC_FORMAT=hex

# How the string task_id maps to a circuit field element:
# "keccak" (default) | "numeric" | "hex" — confirm in practice mode.
GATEKEEPER_TASK_ID_MODE=keccak

# OPTIONAL: Kurier API key for best-effort on-chain finalization of proofs.
KURIER_API_KEY=

# Local server port (ignored on Vercel).
PORT=8787

# Seen-set store for PROOF_REUSED detection.
# On Vercel set this to /tmp/seen.json (project fs is read-only/ephemeral).
SEEN_STORE_PATH=
